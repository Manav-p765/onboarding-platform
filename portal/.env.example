# Copy to .env.local (dev) or .env (server) and fill in.

# 64 hex chars (32 bytes). Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# KEEP THIS OUT OF BACKUPS. Losing it = stored passwords can't be decrypted.
ENCRYPTION_KEY=

# Where the SQLite file and uploads live
DATA_DIR=./data

# Public URL of the portal (used in invite links)
APP_URL=http://localhost:3000

# Email is OFF by design (agency decision). Leave SMTP_* empty.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Agency Name <onboard@example.com>"
