# /opt/onboard/.env  (chmod 600). Never commit, never include in backups.

# Generate on the server:  openssl rand -hex 32
ENCRYPTION_KEY=

APP_URL=https://onboard.growmysecuritycompany.com

# Email is OFF by design (agency decision). Leave these empty.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Agency Name <onboard@your-verified-domain.com>"

# ---- Optional offsite backups (off while BACKUP_REMOTE is empty) ----
# Example: Backblaze B2, encrypted before upload (rclone "crypt" on top of "b2").
# BACKUP_REMOTE=offsite:
# RCLONE_CONFIG_B2_TYPE=b2
# RCLONE_CONFIG_B2_ACCOUNT=<keyID>
# RCLONE_CONFIG_B2_KEY=<applicationKey>
# RCLONE_CONFIG_OFFSITE_TYPE=crypt
# RCLONE_CONFIG_OFFSITE_REMOTE=b2:your-bucket/onboard
# RCLONE_CONFIG_OFFSITE_PASSWORD=<output of: rclone obscure 'a-long-random-passphrase'>
BACKUP_REMOTE=
